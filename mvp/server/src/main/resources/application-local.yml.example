# 本文件不进 git。复制为 application-local.yml 后填写沙箱密钥。
# 启动：mvn spring-boot:run -Dspring-boot.run.profiles=local

qs:
  pay:
    # 换成你的穿透地址，例如 https://xxxx.ngrok-free.app
    notify-base-url: https://替换成你的公网域名
    alipay:
      enabled: true
      sandbox: true
      dev-simulate: false
      # 开放平台 → 沙箱应用 APPID（或正式 APPID，sandbox 改 false）
      app-id: "替换成沙箱APPID"
      # 应用私钥（RSA2，不要带引号外的换行问题；可用一行 Base64）
      private-key: |
        替换成应用私钥
      # 支付宝公钥（开放平台下载的「支付宝公钥」，不是应用公钥）
      alipay-public-key: |
        替换成支付宝公钥
